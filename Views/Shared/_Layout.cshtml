<!DOCTYPE html>
<html lang="en" data-app-base="@Url.Content("~/")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · eBay · Inventory Manager</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1d1a16" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <script type="importmap"></script>
    <script src="~/js/app-base.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var c  = ViewContext.RouteData.Values["controller"]?.ToString();
        var a  = ViewContext.RouteData.Values["action"]?.ToString();

        // Topbar active helper
        Func<string, string, string> tb = (ctrl, act) =>
            c == ctrl && a == act ? "topbar-btn topbar-btn-primary" : "topbar-btn";

        // Sidebar link active helper
        Func<string, string, string> sl = (ctrl, act) =>
            c == ctrl && a == act ? "dashboard-link is-active" : "dashboard-link";

        // Sidebar sublink active helper
        Func<string, string, string> ssl = (ctrl, act) =>
            c == ctrl && a == act ? "dashboard-sublink is-active" : "dashboard-sublink";



        <div class="dashboard-shell">
            <!-- Mobile topbar -->
            <div class="dashboard-topbar">
                <button id="sidebarToggle" class="topbar-hamburger" type="button" aria-label="Open navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <div class="topbar-actions">
                    <a class="@tb("Home","Index")" asp-controller="Home" asp-action="Index">Home</a>
                    <a class="@tb("Home","Scan")" asp-controller="Home" asp-action="Scan">Scan</a>
                    <a class="@tb("Inventory","ActiveInventory")" asp-controller="Inventory" asp-action="ActiveInventory">Inventory</a>
                    <a class="@tb("Inventory","MissingData")" asp-controller="Inventory" asp-action="MissingData">Missing</a>
                    <a class="@tb("Inventory","NeedsAttention")" asp-controller="Inventory" asp-action="NeedsAttention">Attention @await Component.InvokeAsync("NeedsAttentionBadge")</a>
                    <a class="@tb("Inventory","BulkReprice")" asp-controller="Inventory" asp-action="BulkReprice">Reprice</a>
                    <a class="@tb("Inventory","UnprintedLabels")" asp-controller="Inventory" asp-action="UnprintedLabels">Unprinted</a>
                    <a class="@tb("Orders","Recent")" asp-controller="Orders" asp-action="Recent">Orders</a>
                    <a class="@tb("Orders","ReadyToShip")" asp-controller="Orders" asp-action="ReadyToShip">Ship</a>
                    <a class="@tb("Orders","RetrieveFromInventory")" asp-controller="Orders" asp-action="RetrieveFromInventory">Retrieve</a>
                    <a class="@tb("Promotions","Index")" asp-controller="Promotions" asp-action="Index">Promos</a>
                    <a class="@tb("Drafts","Index")" asp-controller="Drafts" asp-action="Index">Drafts</a>
                    <a class="@tb("Box","Index")" asp-controller="Box" asp-action="Index">Boxes</a>
                    <a class="@tb("Shelf","Index")" asp-controller="Shelf" asp-action="Index">Shelves</a>
                    <a class="@tb("StorageUnit","Index")" asp-controller="StorageUnit" asp-action="Index">Storage</a>
                    <a class="@tb("ShippingBoxes","Index")" asp-controller="ShippingBoxes" asp-action="Index">Ship Boxes</a>
                    <a class="@tb("Consignors","Index")" asp-controller="Consignors" asp-action="Index">Consignors</a>
                    <a class="@tb("Receipts","Index")" asp-controller="Receipts" asp-action="Index">Receipts</a>
                    <a class="@tb("Stats","Index")" asp-controller="Stats" asp-action="Index">Stats</a>
                </div>
            </div>

            <div id="dashboardOverlay" class="dashboard-overlay"></div>

            <!-- Sidebar -->
            <aside class="dashboard-sidebar">

                <a class="sidebar-brand-area" asp-area="" asp-controller="Home" asp-action="Index" aria-label="eBay inventory home">
                    <span class="sidebar-brand-icon" aria-hidden="true">
                        <svg viewBox="0 0 64 64"><rect width="64" height="64" rx="10" fill="#c0935f"/><rect x="25" width="14" height="64" fill="#e6d3ad" opacity=".55"/><path d="M46.5 21.5A17 17 0 1 0 49 35H33" fill="none" stroke="#1d1a16" stroke-width="8.5" stroke-linecap="square"/></svg>
                    </span>
                    <span class="sidebar-brand-text">
                        <span class="sidebar-brand-name">Inventory Manager</span>
                        <span class="sidebar-brand-sub"><b>eBay</b>Store</span>
                    </span>
                </a>

                <nav class="dashboard-nav">

                    <div class="nav-section-label">General</div>

                    <a class="@sl("Home","Index")" asp-area="" asp-controller="Home" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                        </svg>
                        Overview
                    </a>

                    <a class="@sl("Home","Scan")" asp-area="" asp-controller="Home" asp-action="Scan">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/>
                        </svg>
                        Scan
                    </a>

                    <div class="nav-section-label">Inventory</div>

                    <button class="dashboard-link dashboard-dropdown-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#inventoryMenu" aria-expanded="true" aria-controls="inventoryMenu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
                        </svg>
                        Inventory
                        <svg class="dashboard-dropdown-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="collapse show dashboard-subnav" id="inventoryMenu">
                        <a class="@ssl("Inventory","ActiveInventory")" asp-area="" asp-controller="Inventory" asp-action="ActiveInventory">Active Inventory</a>
                        <a class="@ssl("Inventory","MissingData")" asp-area="" asp-controller="Inventory" asp-action="MissingData">Missing Location</a>
                        <a class="@ssl("Inventory","NeedsAttention")" asp-area="" asp-controller="Inventory" asp-action="NeedsAttention">Needs Attention @await Component.InvokeAsync("NeedsAttentionBadge")</a>
                        <a class="@ssl("Inventory","BulkReprice")" asp-area="" asp-controller="Inventory" asp-action="BulkReprice">Bulk Reprice</a>
                        <a class="@ssl("Inventory","UnprintedLabels")" asp-area="" asp-controller="Inventory" asp-action="UnprintedLabels">Unprinted Labels</a>
                    </div>

                    <div class="nav-section-label">Orders</div>

                    <button class="dashboard-link dashboard-dropdown-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#ordersMenu" aria-expanded="true" aria-controls="ordersMenu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"/>
                        </svg>
                        Orders
                        <svg class="dashboard-dropdown-chevron" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </button>
                    <div class="collapse show dashboard-subnav" id="ordersMenu">
                        <a class="@ssl("Orders","Recent")" asp-area="" asp-controller="Orders" asp-action="Recent">Recent Orders</a>
                        <a class="@ssl("Orders","ReadyToShip")" asp-area="" asp-controller="Orders" asp-action="ReadyToShip">Ready to Ship</a>
                        <a class="@ssl("Orders","RetrieveFromInventory")" asp-area="" asp-controller="Orders" asp-action="RetrieveFromInventory">Retrieve from Inventory</a>
                    </div>

                    <div class="nav-section-label">Marketing</div>

                    <a class="@sl("Promotions","Index")" asp-area="" asp-controller="Promotions" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L9.568 3z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/>
                        </svg>
                        Promotions
                    </a>

                    <a class="@sl("Drafts","Index")" asp-area="" asp-controller="Drafts" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                        </svg>
                        Drafts
                    </a>

                    <div class="nav-section-label">Storage</div>

                    <a class="@sl("Box","Index")" asp-area="" asp-controller="Box" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
                        </svg>
                        Boxes
                    </a>

                    <a class="@sl("Shelf","Index")" asp-area="" asp-controller="Shelf" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                        </svg>
                        Shelving Units
                    </a>

                    <a class="@sl("StorageUnit","Index")" asp-area="" asp-controller="StorageUnit" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 8.485-7.5 11.9-7.5 11.9s-7.5-3.415-7.5-11.9a7.5 7.5 0 1115 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5z"/>
                        </svg>
                        Storage Units
                    </a>

                    <a class="@sl("ShippingBoxes","Index")" asp-area="" asp-controller="ShippingBoxes" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                        </svg>
                        Shipping Boxes
                    </a>

                    <a class="@sl("Consignors","Index")" asp-area="" asp-controller="Consignors" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>
                        </svg>
                        Consignors
                    </a>

                    <a class="@sl("Receipts","Index")" asp-area="" asp-controller="Receipts" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0c1.1.128 1.907 1.077 1.907 2.185zM9.75 9h.008v.008H9.75V9zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 4.5h.008v.008h-.008V13.5zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
                        </svg>
                        Receipts
                    </a>

                    <a class="@sl("Stats","Index")" asp-area="" asp-controller="Stats" asp-action="Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
                        </svg>
                        Stats
                    </a>

                </nav>

                <!-- Account -->
                <div class="dashboard-account">
                    <a href="/" class="account-home" title="Back to the seller dashboard">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
                        </svg>
                        Seller dashboard
                    </a>
                    <a href="/account/password" class="account-logout-btn" title="Change password" aria-label="Change password">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                        </svg>
                    </a>
                </div>

            </aside>

            <section class="dashboard-content">
                <main role="main">
                    @RenderBody()
                </main>
                <footer class="dashboard-footer">
                    <span>Inventory Manager &middot; eBay</span>
                    <a href="https://www.ebay.com/" target="_blank" rel="noopener">View store on eBay &nearr;</a>
                </footer>
            </section>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="layoutPreSync" class="d-none"></div>
    }
    <script>
        (function () {
            const toggleBtn = document.getElementById("sidebarToggle");
            const sidebar = document.querySelector(".dashboard-sidebar");
            const overlay = document.getElementById("dashboardOverlay");
            if (toggleBtn && sidebar && overlay) {
                function openSidebar() {
                    sidebar.classList.add("open");
                    overlay.classList.add("active");
                    document.body.style.overflow = "hidden";
                }
                function closeSidebar() {
                    sidebar.classList.remove("open");
                    overlay.classList.remove("active");
                    document.body.style.overflow = "";
                }

                toggleBtn.addEventListener("click", openSidebar);
                overlay.addEventListener("click", closeSidebar);
                sidebar.querySelectorAll(".dashboard-link, .dashboard-sublink").forEach(function (el) {
                    el.addEventListener("click", closeSidebar);
                });
            }

            if (document.getElementById("layoutPreSync")) {
                fetch(appUrl("/Orders/TriggerSync")).catch(function () {});
                fetch(appUrl("/Inventory/TriggerSync")).catch(function () {});
            }
        })();
    </script>
</body>
</html>
