<div class="empty-state">
    <div class="empty-state-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="@iconPath" />
        </svg>
    </div>
    <p class="empty-state-title">@Model.Title</p>
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <p class="empty-state-message">@Model.Message</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionUrl))
    {
        <a href="@Model.ActionUrl" class="btn btn-primary btn-sm empty-state-action">@Model.ActionText</a>
    }
</div>
