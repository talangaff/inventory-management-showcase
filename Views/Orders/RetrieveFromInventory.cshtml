@model inventory_management.Models.RetrieveFromInventoryViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.PageTitle;
    var itemsJson = JsonSerializer.Serialize(Model.Items.Select(x => new
    {
        itemId = x.ItemId,
        itemName = x.ItemName,
        totalQuantity = x.TotalQuantity,
        barcode = x.Barcode
    }));
}

<div id="retrieveConfig" class="d-none" data-items="@itemsJson"></div>
@Html.AntiForgeryToken()

<div class="page-header page-header-flex mb-4">
    <div>
        <h1 class="page-header-title">
            @Model.PageTitle
            @if (Model.Items.Count > 0)
            {
                <span class="text-muted fw-normal ms-1" style="font-size:0.85em;">(@Model.Items.Count)</span>
            }
        </h1>
        <p class="page-header-subtitle">Scan each unit as you pull it to mark it retrieved.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}

@if (Model.IsConnected)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h6 mb-3">Scan Item Barcode</h2>
            <div class="d-flex gap-2 mb-3">
                <button id="retrieveStartScan" class="btn btn-success btn-sm" type="button">Start Camera</button>
                <button id="retrieveStopScan" class="btn btn-outline-secondary btn-sm" type="button">Stop</button>
            </div>
            <div class="border rounded p-1 bg-dark-subtle mb-3" style="max-width:480px;">
                <video id="retrieveScannerVideo" class="w-100" style="max-height:300px;" muted playsinline></video>
            </div>
            <div class="mb-3" style="max-width:320px;">
                <label class="form-label small mb-1">Or type / scan with USB scanner:</label>
                <input id="retrieveKeyboardInput" type="text" class="form-control form-control-sm" placeholder="Scan or type barcode, press Enter" autocomplete="off" />
            </div>
            <small id="retrieveScanStatus" class="text-muted">Camera is off.</small>
        </div>
    </div>

    <div id="retrieveFeedback" class="alert d-none mb-3" role="alert"></div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h2 class="h6 mb-3">Items to Retrieve</h2>

            @if (!Model.Items.Any())
            {
                <partial name="_EmptyState" model="@(new EmptyStateViewModel {
                    Icon = "box",
                    Title = "Nothing to retrieve",
                    Message = "Items awaiting retrieval from storage will show up here."
                })" />
            }
            else
            {
                <ul id="retrieveItemList" class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <li class="list-group-item px-0 retrieve-list-item" data-item-id="@item.ItemId" style="transition: opacity 0.35s ease;">
                            <div class="d-flex gap-3 align-items-start">
                                @if (!string.IsNullOrWhiteSpace(item.ItemPhotoUrl))
                                {
                                    <img src="@item.ItemPhotoUrl" alt="@item.ItemName" style="width:60px;height:60px;object-fit:cover;border-radius:6px;flex-shrink:0;" />
                                }
                                else
                                {
                                    <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted flex-shrink-0" style="width:60px;height:60px;font-size:11px;">
                                        No image
                                    </div>
                                }
                                <div class="flex-grow-1">
                                    <strong class="d-block">@item.ItemName</strong>
                                    <div class="small text-muted">Item ID: <span class="font-monospace">@item.ItemId</span></div>
                                    @if (!string.IsNullOrWhiteSpace(item.StorageLocationDisplay))
                                    {
                                        <div class="small">
                                            <span class="badge bg-success-subtle text-success-emphasis border">@item.StorageLocationDisplay</span>
                                        </div>
                                    }
                                    @if (item.BuyerNames.Any())
                                    {
                                        <div class="small text-muted">Buyer@(item.BuyerNames.Count > 1 ? "s" : ""): @string.Join(", ", item.BuyerNames)</div>
                                    }
                                    <div class="mt-2" style="max-width:240px;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <small class="retrieve-progress">0 / @item.TotalQuantity scanned</small>
                                        </div>
                                        <div class="progress" style="height:6px;">
                                            <div class="progress-bar bg-success retrieve-progress-bar"
                                                 role="progressbar"
                                                 style="width:0%"
                                                 aria-valuenow="0"
                                                 aria-valuemin="0"
                                                 aria-valuemax="@item.TotalQuantity"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
                <p id="retrieveEmptyMsg" class="text-success mb-0 d-none">All items have been retrieved!</p>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://unpkg.com/%40zxing/browser%400.1.5/umd/zxing-browser.min.js"></script>
    <script src="~/js/retrieve-from-inventory.js" asp-append-version="true"></script>
}
