@model inventory_management.Models.StorageUnitFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Storage Unit" : "Add Storage Unit";
}

<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 8.485-7.5 11.9-7.5 11.9s-7.5-3.415-7.5-11.9a7.5 7.5 0 1115 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5z" />
            </svg>
        </div>
        <div>
            <h1>@ViewData["Title"]</h1>
            <p>@(isEdit ? "Update this storage unit's name or code." : "Add a new piece of storage furniture to track.")</p>
        </div>
    </div>
    <div class="form-card-body">
        <form asp-controller="StorageUnit" asp-action="@(isEdit ? "Edit" : "Create")" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Blue Cabinet" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Identifier" class="form-label"></label>
                <input asp-for="Identifier" class="form-control" placeholder="e.g. CAB-1" style="text-transform:uppercase;" />
                <div class="form-text">Short code used in location displays and barcodes. Letters, numbers, hyphens, underscores only.</div>
                <span asp-validation-for="Identifier" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(isEdit ? "Save Changes" : "Create Storage Unit")</button>
                <a asp-controller="StorageUnit" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />
}
