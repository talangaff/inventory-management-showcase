@model inventory_management.Models.ShippingBoxFormViewModel
@{
    ViewData["Title"] = "New Shipping Box Size";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small">&larr; Shipping Boxes</a>
</div>

<div class="form-card" style="max-width:600px;">
    <div class="form-card-header">
        <div class="form-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
        </div>
        <div>
            <h1>New Shipping Box Size</h1>
            <p>Define a box size you ship with.</p>
        </div>
    </div>
    <div class="form-card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Small Mailer, 12x10x4" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold mb-2">Dimensions (inches)</legend>
                <div class="row g-2">
                    <div class="col-4">
                        <label asp-for="LengthIn" class="form-label small"></label>
                        <input asp-for="LengthIn" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="LengthIn" class="text-danger small"></span>
                    </div>
                    <div class="col-4">
                        <label asp-for="WidthIn" class="form-label small"></label>
                        <input asp-for="WidthIn" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="WidthIn" class="text-danger small"></span>
                    </div>
                    <div class="col-4">
                        <label asp-for="HeightIn" class="form-label small"></label>
                        <input asp-for="HeightIn" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="HeightIn" class="text-danger small"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="fs-6 fw-semibold mb-2">Weight <span class="text-muted fw-normal">(optional)</span></legend>
                <div class="row g-2">
                    <div class="col-6">
                        <label asp-for="WeightLbs" class="form-label small"></label>
                        <input asp-for="WeightLbs" type="number" min="0" max="999" class="form-control" placeholder="lbs" />
                        <span asp-validation-for="WeightLbs" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="WeightOz" class="form-label small"></label>
                        <input asp-for="WeightOz" type="number" step="0.1" min="0" max="15.9" class="form-control" placeholder="oz" />
                        <span asp-validation-for="WeightOz" class="text-danger small"></span>
                    </div>
                </div>
            </fieldset>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

