@model inventory_management.Models.ShippingBoxIndexViewModel
@{
    ViewData["Title"] = "Shipping Boxes";
}

<div class="page-header page-header-flex mb-4">
    <div>
        <h1 class="page-header-title">Shipping Boxes</h1>
        <p class="page-header-subtitle">Box sizes you ship with and how many of each are in stock.</p>
    </div>
    <div class="page-header-actions">
        <a asp-action="Create" class="btn btn-primary btn-sm">+ New Box Size</a>
    </div>
</div>

@if (!Model.Boxes.Any())
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel {
        Icon = "box",
        Title = "No shipping box sizes yet",
        Message = "Add a box size to start tracking how many you have in stock.",
        ActionText = "New Box Size",
        ActionUrl = Url.Action("Create")
    })" />
}
else
{
    <div class="table-responsive table-card">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Size (L × W × H)</th>
                    <th>Weight</th>
                    <th class="text-center">In Stock</th>
                    <th>Add Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var box in Model.Boxes)
                {
                    <tr>
                        <td class="fw-semibold">@box.Name</td>
                        <td>@box.LengthIn" × @box.WidthIn" × @box.HeightIn"</td>
                        <td>
                            @if (box.WeightLbs.HasValue || box.WeightOz.HasValue)
                            {
                                var lbs = box.WeightLbs ?? 0;
                                var oz = box.WeightOz ?? 0;
                                if (lbs > 0 && oz > 0)
                                {
                                    <span>@lbs lb @oz oz</span>
                                }
                                else if (lbs > 0)
                                {
                                    <span>@lbs lb</span>
                                }
                                else
                                {
                                    <span>@oz oz</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary fs-6">@box.Quantity</span>
                        </td>
                        <td>
                            <form asp-action="AddStock" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Id" value="@box.Id" />
                                <input type="number" name="Amount" value="1" min="1" max="9999"
                                       class="form-control form-control-sm" style="width:80px" />
                                <button type="submit" class="btn btn-outline-success btn-sm">Add</button>
                            </form>
                        </td>
                        <td class="text-end">
                            <div class="dropdown action-menu">
                                <button class="btn btn-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @box.Name">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.75"/><circle cx="12" cy="12" r="1.75"/><circle cx="12" cy="19" r="1.75"/></svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@box.Id">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
                                            Edit
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <button type="button" class="dropdown-item text-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteBoxSizeModal"
                                                data-id="@box.Id" data-name="@box.Name">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                                            Delete
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_DeleteConfirmModal" model="@(new DeleteConfirmModalViewModel {
        ModalId = "deleteBoxSizeModal",
        Title = "Delete Shipping Box",
        ItemNoun = "shipping box size",
        DeleteActionUrl = Url.Action("Delete") ?? string.Empty,
        IdFieldName = "id"
    })" />
}

@section Scripts {
    <script src="~/js/shipping-boxes-index.js" asp-append-version="true"></script>
}
