@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Overview";
    var us = CultureInfo.GetCultureInfo("en-US");
    string Money(decimal v) => v.ToString("C0", us);
    string MoneyCents(decimal? v) => v.HasValue ? v.Value.ToString("C2", us) : "—";
}

<div class="page-header page-header-flex mb-4">
    <div>
        <h1 class="page-header-title">Overview</h1>
        <p class="page-header-subtitle">Your store on eBay &middot; @DateTime.Now.ToString("dddd, MMMM d", us)</p>
    </div>
    <div class="page-header-actions">
        <a class="btn btn-outline-secondary" href="https://www.ebay.com/" target="_blank" rel="noopener">Store on eBay &nearr;</a>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Scan">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="me-1" aria-hidden="true" style="vertical-align:-3px">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75v-.75zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75v-.75zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75v-.75zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75v-.75z"/>
            </svg>
            Scan
        </a>
    </div>
</div>

@if (!Model.IsConnected)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4" role="alert">
        <span><strong>eBay isn't connected.</strong> Listings and orders won't sync until it is.</span>
        <form asp-controller="Inventory" asp-action="ConnectEbay" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-primary">Connect eBay</button>
        </form>
    </div>
}

<div class="dash-section-label mb-2">Waiting on you</div>
    @{
        var todo = new[]
        {
            (Count: Model.ReadyToShip, Label: "Ready to ship", Note: "orders without tracking", Ctrl: "Orders", Act: "ReadyToShip", Tone: "ink"),
            (Count: Model.NeedsAttention, Label: "Needs attention", Note: "stale, sold out, or unresolved", Ctrl: "Inventory", Act: "NeedsAttention", Tone: "alarm"),
            (Count: Model.MissingLocation, Label: "Missing location", Note: "listed, not on a shelf or in a box", Ctrl: "Inventory", Act: "MissingData", Tone: "ink"),
            (Count: Model.UnprintedLabels, Label: "Unprinted labels", Note: "listings with a label to print", Ctrl: "Inventory", Act: "UnprintedLabels", Tone: "ink"),
        }.Where(t => t.Count > 0).ToList(); // only categories with something in them
    }
@if (todo.Count == 0)
{
    <p class="dash-all-clear mb-4">Nothing waiting on you.</p>
}
else
{
<div class="dash-stats dash-stats-auto mb-4">
    @foreach (var t in todo)
    {
        <a class="dash-stat is-@t.Tone" asp-controller="@t.Ctrl" asp-action="@t.Act">
            <span class="dash-stat-label">@t.Label</span>
            <span class="dash-stat-value">@t.Count</span>
            <span class="dash-stat-note">@t.Note</span>
            <span class="dash-stat-go" aria-hidden="true">&rarr;</span>
        </a>
    }
</div>
}

<div class="dash-section-label mb-2">Store</div>
<div class="dash-stats dash-stats-3 mb-4">
    <a class="dash-stat is-plain" asp-controller="Inventory" asp-action="ActiveInventory">
        <span class="dash-stat-label">Active listings</span>
        <span class="dash-stat-value">@Model.ActiveListings</span>
        <span class="dash-stat-note">live on eBay</span>
        <span class="dash-stat-go" aria-hidden="true">&rarr;</span>
    </a>
    <a class="dash-stat is-plain" asp-controller="Inventory" asp-action="ActiveInventory">
        <span class="dash-stat-label">Listed value</span>
        <span class="dash-stat-value">@Money(Model.ListedValue)</span>
        <span class="dash-stat-note">asking price &times; quantity</span>
        <span class="dash-stat-go" aria-hidden="true">&rarr;</span>
    </a>
    <a class="dash-stat is-plain" asp-controller="Stats" asp-action="Index">
        <span class="dash-stat-label">Sold &middot; last 30 days</span>
        <span class="dash-stat-value">@Model.Sold30Days</span>
        <span class="dash-stat-note">@Money(Model.Gross30Days) gross</span>
        <span class="dash-stat-go" aria-hidden="true">&rarr;</span>
    </a>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-8">
        <div class="dash-section-label mb-2">Recent sales</div>
        @if (Model.RecentSales.Count == 0)
        {
            <p class="text-muted small mb-0">No sales recorded yet.</p>
        }
        else
        {
            <div class="table-responsive table-card">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-end">Sold for</th>
                            <th class="text-end">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSales)
                        {
                            <tr>
                                <td class="dash-sale-title">
                                    @if (s.ItemId != null)
                                    {
                                        <a asp-controller="Inventory" asp-action="Details" asp-route-id="@s.ItemId" class="text-decoration-none">@s.Title</a>
                                    }
                                    else
                                    {
                                        @s.Title
                                    }
                                </td>
                                <td class="text-end font-monospace">@MoneyCents(s.SalePriceGross)</td>
                                <td class="text-end text-muted text-nowrap">@s.SoldAtUtc.ToLocalTime().ToString("MMM d", us)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-12 col-xl-4">
        <div class="dash-section-label mb-2">Shortcuts</div>
        <div class="dash-shortcuts">
            <a asp-controller="Orders" asp-action="RetrieveFromInventory">Retrieve sold items<span>&rarr;</span></a>
            <a asp-controller="Inventory" asp-action="BulkReprice">Bulk reprice<span>&rarr;</span></a>
            <a asp-controller="Receipts" asp-action="Index">Receipts<span>&rarr;</span></a>
            <a asp-controller="Drafts" asp-action="Index">Drafts<span>&rarr;</span></a>
            <a asp-controller="Stats" asp-action="Index">Sales stats<span>&rarr;</span></a>
        </div>
    </div>
</div>
