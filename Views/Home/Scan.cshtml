@{
    ViewData["Title"] = "Scan";
}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="page-header mb-3">
            <div>
                <h1 class="page-header-title">Scan QR Code</h1>
                <p class="page-header-subtitle">Scan an item, shelf, or box barcode to assign a location.</p>
            </div>
        </div>

        <div class="btn-group mb-3 scan-mode-group" role="group" aria-label="Scanner mode">
            <button id="modeUsbBtn" class="btn btn-primary" type="button">USB / BT Scanner</button>
            <button id="modeCameraBtn" class="btn btn-outline-primary" type="button">Camera</button>
        </div>

        <div id="cameraModeControls" class="d-none">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button id="startScanBtn" class="btn btn-success" type="button">Start Camera Scan</button>
                <button id="stopScanBtn" class="btn btn-outline-secondary" type="button">Stop</button>
                <button id="torchBtn" class="btn btn-outline-warning" type="button" disabled><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-2px" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/></svg>Flashlight</button>
            </div>
            <div class="border rounded p-2 bg-dark-subtle mb-3">
                <video id="scannerVideo" class="w-100" style="max-height:420px;" muted playsinline></video>
            </div>
        </div>

        <div id="usbModeControls">
            <div class="alert alert-primary d-flex align-items-center gap-3 mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0113.5 9.375v-4.5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75zM6.75 16.5h.75v.75h-.75v-.75zM16.5 6.75h.75v.75h-.75v-.75zM13.5 13.5h.75v.75h-.75v-.75zM13.5 19.5h.75v.75h-.75v-.75zM19.5 13.5h.75v.75h-.75v-.75zM19.5 19.5h.75v.75h-.75v-.75zM16.5 16.5h.75v.75h-.75v-.75z"/></svg>
                <div>
                    <strong>USB / Bluetooth Scanner Active</strong><br>
                    <small>Point your scanner at a QR code and pull the trigger. Input is captured automatically.</small>
                </div>
            </div>
            <div class="border rounded p-4 bg-dark-subtle mb-3 text-center text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="mb-2 scan-wait-icon"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 3.75H6A2.25 2.25 0 003.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0120.25 6v1.5m0 9V18A2.25 2.25 0 0118 20.25h-1.5m-9 0H6A2.25 2.25 0 013.75 18v-1.5M3.75 12h16.5"/></svg>
                <div>Waiting for scanner input&hellip;</div>
                <input id="usbScannerInput" type="text" class="form-control mt-3" placeholder="Or type / paste a QR code value and press Enter" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
            </div>
        </div>

        <div class="alert alert-info mb-2">
            Scanned Number: <strong id="scanResult">None yet</strong>
        </div>
        <div class="alert alert-warning mb-2">
            Current Storage: <strong id="currentStorage">None selected</strong>
        </div>
        <div class="alert alert-secondary mb-2">
            Scan Match: <strong id="scanMatch">None yet</strong>
        </div>
        <div id="shelfSlotPanel" class="card border-0 shadow-sm mt-3 d-none">
            <div class="card-body">
                <h2 class="h6 mb-2">Shelf Slot: <strong id="shelfSlotLabel"></strong></h2>
                <div class="mb-3">
                    <label class="form-label small mb-1">Slot Status</label>
                    <select id="shelfSlotStatus" class="form-select form-select-sm">
                        <option value="0">Active Inventory</option>
                        <option value="1">Unlisted</option>
                        <option value="2">Needs Sorted</option>
                    </select>
                </div>
                <div class="d-flex align-items-center gap-2 mb-3">
                    <button id="saveShelfSlotBtn" class="btn btn-sm btn-primary" type="button">Save Status</button>
                    <button id="viewShelfSlotItemsBtn" class="btn btn-sm btn-outline-secondary" type="button">View Items on Shelf</button>
                    <span id="shelfSlotSaveStatus" class="small text-muted"></span>
                </div>
                <div id="shelfSlotItemsContainer" class="d-none">
                    <p class="small fw-semibold mb-1">Items on this shelf:</p>
                    <ul id="shelfSlotItemsList" class="list-group list-group-flush"></ul>
                </div>
            </div>
        </div>
        <div id="itemPanel" class="card border-0 shadow-sm mt-3 d-none">
            <div class="card-body">
                <div class="d-flex gap-3 align-items-start">
                    <img id="itemPanelPhoto" class="rounded flex-shrink-0" style="width:64px;height:64px;object-fit:cover;display:none;" src="" alt="Item photo" />
                    <div class="flex-grow-1">
                        <div class="fw-semibold" id="itemPanelTitle"></div>
                        <div class="small text-muted mt-1">Location: <span id="itemPanelLocation">None</span></div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3 align-items-center">
                    <a id="itemPanelViewBtn" class="btn btn-sm btn-outline-primary" href="#" target="_blank">View Item</a>
                    <button id="itemPanelRemoveBtn" class="btn btn-sm btn-outline-danger" type="button">Remove Location</button>
                    <span id="itemPanelStatus" class="small text-muted"></span>
                </div>
            </div>
        </div>
        <div id="shelfUnitPanel" class="card border-0 shadow-sm mt-3 d-none">
            <div class="card-body">
                <h2 class="h6 mb-2">Shelf Unit: <strong id="shelfUnitIdentifier"></strong></h2>
                <div class="mb-3">
                    <label class="form-label small mb-1">Unit Status</label>
                    <select id="shelfUnitStatus" class="form-select form-select-sm">
                        <option value="0">Active Inventory</option>
                        <option value="1">Unlisted</option>
                        <option value="2">Needs Sorted</option>
                    </select>
                </div>
                <div id="shelfSlotsContainer" class="mb-3"></div>
                <div class="d-flex align-items-center gap-2">
                    <button id="saveShelfUnitBtn" class="btn btn-sm btn-primary" type="button">Save</button>
                    <span id="shelfUnitSaveStatus" class="small text-muted"></span>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-body">
                <h2 class="h6 mb-2">Recent Assigned Items</h2>
                <ul id="scanAssignmentLog" class="list-group list-group-flush"></ul>
            </div>
        </div>
        <small id="scanStatus" class="text-muted">Ready for USB / BT scanner input.</small>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/%40zxing/browser%400.1.5/umd/zxing-browser.min.js"></script>
    <script>
        const scanResult = document.getElementById("scanResult");
        const currentStorage = document.getElementById("currentStorage");
        const scanMatch = document.getElementById("scanMatch");
        const scanAssignmentLog = document.getElementById("scanAssignmentLog");
        const scanStatus = document.getElementById("scanStatus");
        const startScanBtn = document.getElementById("startScanBtn");
        const stopScanBtn = document.getElementById("stopScanBtn");
        const torchBtn = document.getElementById("torchBtn");
        const scannerVideo = document.getElementById("scannerVideo");

        let torchOn = false;
        let videoTrack = null;

        const codeReader = new ZXingBrowser.BrowserMultiFormatReader();
        let scannerControls = null;
        let activeStorage = null;
        let lastScannedValue = "";
        let lastScannedAtMs = 0;
        let lastProcessedBarcode = "";
        let audioContext = null;
        let audioReady = false;

        // Builds a data URI for a minimal 1-sample silent WAV.
        // Playing this through an <audio> element promotes the iOS audio session to
        // "Playback" category, which bypasses the hardware silent switch.
        function buildSilentWavDataUri() {
            const buf = new ArrayBuffer(45);
            const v = new DataView(buf);
            const s = (o, c) => { for (let i = 0; i < c.length; i++) v.setUint8(o + i, c.charCodeAt(i)); };
            s(0,  "RIFF"); v.setUint32(4,  37, true);
            s(8,  "WAVE");
            s(12, "fmt "); v.setUint32(16, 16, true);
            v.setUint16(20, 1, true);    // PCM
            v.setUint16(22, 1, true);    // mono
            v.setUint32(24, 8000, true); // sample rate
            v.setUint32(28, 8000, true); // byte rate
            v.setUint16(32, 1, true);    // block align
            v.setUint16(34, 8, true);    // bits per sample
            s(36, "data"); v.setUint32(40, 1, true);
            v.setUint8(44, 128); // 1 sample of silence (unsigned 8-bit midpoint)
            const bytes = new Uint8Array(buf);
            let bin = "";
            for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
            return "data:audio/wav;base64," + btoa(bin);
        }

        let silentWavUri = null;

        function ensureAudioContext() {
            if (!audioContext) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) {
                    return null;
                }

                audioContext = new AudioCtx();
            }

            return audioContext;
        }

        function playTone(frequency, durationMs, type = "sine", startDelaySec = 0) {
            const ctx = ensureAudioContext();
            if (!ctx) {
                return;
            }

            try {
                const oscillator = ctx.createOscillator();
                const gain = ctx.createGain();
                oscillator.type = type;
                oscillator.frequency.setValueAtTime(frequency, ctx.currentTime + startDelaySec);
                gain.gain.setValueAtTime(0.0001, ctx.currentTime + startDelaySec);
                gain.gain.linearRampToValueAtTime(0.35, ctx.currentTime + startDelaySec + 0.01);
                gain.gain.linearRampToValueAtTime(0.0001, ctx.currentTime + startDelaySec + (durationMs / 1000));
                oscillator.connect(gain);
                gain.connect(ctx.destination);
                oscillator.start(ctx.currentTime + startDelaySec);
                oscillator.stop(ctx.currentTime + startDelaySec + (durationMs / 1000));
            } catch (error) {
                console.error("Audio playback failed.", error);
            }
        }

        function unlockAudio() {
            // Play a silent <audio> element — this promotes the iOS audio session from
            // "Ambient" (muted by silent switch) to "Playback" (bypasses silent switch).
            try {
                if (!silentWavUri) silentWavUri = buildSilentWavDataUri();
                const silentEl = new Audio(silentWavUri);
                silentEl.play().catch(() => {});
            } catch (e) {}

            // Also unlock the Web Audio context with a BufferSource node.
            const ctx = ensureAudioContext();
            if (!ctx) {
                return false;
            }
            try {
                const silentBuf = ctx.createBuffer(1, 1, 22050);
                const src = ctx.createBufferSource();
                src.buffer = silentBuf;
                src.connect(ctx.destination);
                src.start(0);
            } catch (e) {}
            ctx.resume().catch(() => {});
            return true;
        }

        function playValidScanSound() {
            playTone(980, 95, "square", 0);
            playTone(1320, 95, "square", 0.11);
            if (navigator.vibrate) {
                navigator.vibrate(35);
            }
        }

        function playInvalidScanSound() {
            playTone(280, 140, "sawtooth", 0);
            playTone(190, 150, "sawtooth", 0.16);
            if (navigator.vibrate) {
                navigator.vibrate([45, 30, 45]);
            }
        }

        function setActiveStorage(storageBarcode, storageLabel) {
            activeStorage = { storageBarcode, storageLabel };
            currentStorage.textContent = `${storageLabel} (${storageBarcode})`;
        }

        function addAssignmentLog(message) {
            if (!scanAssignmentLog) {
                return;
            }

            const li = document.createElement("li");
            li.className = "list-group-item px-0";
            li.textContent = message;
            scanAssignmentLog.prepend(li);

            const maxRows = 15;
            while (scanAssignmentLog.children.length > maxRows) {
                scanAssignmentLog.removeChild(scanAssignmentLog.lastElementChild);
            }
        }

        async function resolveBarcode(scannedValue) {
            try {
                const response = await fetch(appUrl(`/Home/ResolveBarcode?barcode=${encodeURIComponent(scannedValue)}`));
                if (!response.ok) {
                    return { found: false, type: "unknown", message: "Barcode not found" };
                }

                return await response.json();
            } catch (error) {
                console.error(error);
                return { found: false, type: "unknown", message: "Barcode not found" };
            }
        }

        async function assignItemToActiveStorage(itemBarcode) {
            if (!activeStorage) {
                return { success: false, message: "Scan a shelf slot or box barcode first." };
            }

            try {
                const response = await fetch(appUrl("/Home/AssignScannedItem"), {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: JSON.stringify({
                        itemBarcode,
                        storageBarcode: activeStorage.storageBarcode
                    })
                });

                if (!response.ok) {
                    return { success: false, message: "Assignment failed." };
                }

                return await response.json();
            } catch (error) {
                console.error(error);
                return { success: false, message: "Assignment failed." };
            }
        }

        async function processScan(scannedValue) {
            if (scannedValue === lastProcessedBarcode) {
                scanStatus.textContent = "Duplicate scan ignored.";
                return;
            }

            lastProcessedBarcode = scannedValue;
            const resolved = await resolveBarcode(scannedValue);
            if (!resolved?.found) {
                playInvalidScanSound();
                scanMatch.textContent = "Barcode not found";
                return;
            }

            if (resolved.storageEligible && resolved.storageBarcode) {
                playValidScanSound();
                setActiveStorage(resolved.storageBarcode, resolved.storageLabel || resolved.message || "Storage");
                scanMatch.textContent = `Storage set: ${resolved.storageLabel || resolved.storageBarcode}`;
                if (resolved.type === "shelf_slot") {
                    showShelfSlotPanel(resolved);
                }
                return;
            }

            if (resolved.type === "item") {
                showItemPanel(resolved);
                const assignment = await assignItemToActiveStorage(scannedValue);
                scanMatch.textContent = assignment.message || "Assignment failed.";
                if (assignment.success) {
                    playValidScanSound();
                    addAssignmentLog(assignment.message);
                    if (activeStorage) {
                        itemPanelLocation.textContent = activeStorage.storageLabel;
                    }
                } else {
                    playInvalidScanSound();
                }
                return;
            }

            playValidScanSound();

            if (resolved.type === "shelf_unit") {
                scanMatch.textContent = `Shelf unit scanned: ${resolved.message}`;
                await loadShelfUnitPanel(scannedValue);
                return;
            }

            scanMatch.textContent = resolved.message || "Barcode not found";
        }

        async function startScan() {
            if (scannerControls) {
                return;
            }

            try {
                audioReady = await unlockAudio();
                scanStatus.textContent = "Starting camera...";

                const devices = await ZXingBrowser.BrowserCodeReader.listVideoInputDevices();
                let preferredDeviceId = null;

                for (const device of devices) {
                    if (/back|rear|environment/i.test(device.label)) {
                        preferredDeviceId = device.deviceId;
                        break;
                    }
                }

                const videoConstraints = preferredDeviceId
                    ? { deviceId: { exact: preferredDeviceId }, width: { ideal: 1920 }, height: { ideal: 1080 } }
                    : { facingMode: "environment", width: { ideal: 1920 }, height: { ideal: 1080 } };

                scannerControls = await codeReader.decodeFromConstraints(
                    { video: videoConstraints },
                    scannerVideo,
                    (result) => {
                        if (result) {
                            const now = Date.now();
                            const scannedValue = (result.text || "").trim();
                            if (!scannedValue) {
                                return;
                            }

                            // Prevent duplicate rapid-fire reads of the same barcode from repeated frames.
                            if (scannedValue === lastScannedValue && now - lastScannedAtMs < 600) {
                                return;
                            }

                            lastScannedValue = scannedValue;
                            lastScannedAtMs = now;
                            scanResult.textContent = scannedValue;
                            scanStatus.textContent = "Scan detected.";
                            processScan(scannedValue);
                        }
                    }
                );

                // Enable torch button if the camera track supports it
                const stream = scannerVideo.srcObject;
                if (stream) {
                    videoTrack = stream.getVideoTracks()[0];
                    const caps = videoTrack && videoTrack.getCapabilities && videoTrack.getCapabilities();
                    if (caps && caps.torch) {
                        torchBtn.disabled = false;
                    }
                }

                scanStatus.textContent = "Camera active. Point it at a QR code.";
                if (!audioReady) {
                    scanStatus.textContent += " Audio is blocked by this browser/device.";
                }
            } catch (error) {
                scanStatus.textContent = "Could not access camera. Use HTTPS and allow camera permission.";
                console.error(error);
            }
        }

        function stopScan() {
            if (torchOn && videoTrack) {
                videoTrack.applyConstraints({ advanced: [{ torch: false }] }).catch(() => {});
            }
            torchOn = false;
            torchBtn.classList.remove("btn-warning");
            torchBtn.classList.add("btn-outline-warning");
            torchBtn.disabled = true;
            videoTrack = null;

            if (scannerControls) {
                scannerControls.stop();
                scannerControls = null;
            }

            scanStatus.textContent = "Camera is off.";
        }

        torchBtn.addEventListener("click", function () {
            if (!videoTrack) return;
            torchOn = !torchOn;
            videoTrack.applyConstraints({ advanced: [{ torch: torchOn }] }).catch(() => {
                torchOn = !torchOn;
            });
            if (torchOn) {
                torchBtn.classList.remove("btn-outline-warning");
                torchBtn.classList.add("btn-warning");
            } else {
                torchBtn.classList.remove("btn-warning");
                torchBtn.classList.add("btn-outline-warning");
            }
        });

        startScanBtn.addEventListener("click", startScan);
        stopScanBtn.addEventListener("click", stopScan);

        // ── USB / Bluetooth scanner mode ──────────────────────────────────────
        const modeCameraBtn = document.getElementById("modeCameraBtn");
        const modeUsbBtn = document.getElementById("modeUsbBtn");
        const cameraModeControls = document.getElementById("cameraModeControls");
        const usbModeControls = document.getElementById("usbModeControls");
        const usbScannerInput = document.getElementById("usbScannerInput");

        // USB / Bluetooth scanner is the default mode on this page — it's the primary way
        // this page is used (a paired scanner acting as a keyboard wedge). Camera is a
        // secondary fallback for when no physical scanner is available. Do not swap this
        // default back without updating the initial markup state above to match.
        let usbModeActive = true;
        let usbBuffer = "";
        let usbBufferTimer = null;

        function setMode(mode) {
            usbModeActive = (mode === "usb");

            modeCameraBtn.classList.toggle("btn-primary", !usbModeActive);
            modeCameraBtn.classList.toggle("btn-outline-primary", usbModeActive);
            modeUsbBtn.classList.toggle("btn-primary", usbModeActive);
            modeUsbBtn.classList.toggle("btn-outline-primary", !usbModeActive);

            if (usbModeActive) {
                stopScan();
                scanStatus.textContent = "Ready for USB / BT scanner input.";
                cameraModeControls.classList.add("d-none");
                usbModeControls.classList.remove("d-none");
                usbScannerInput.value = "";
                usbScannerInput.focus();
                unlockAudio();
            } else {
                cameraModeControls.classList.remove("d-none");
                usbModeControls.classList.add("d-none");
            }
        }

        modeCameraBtn.addEventListener("click", () => setMode("camera"));
        modeUsbBtn.addEventListener("click", () => setMode("usb"));

        // Initialize into USB/BT mode (the default) so focus/audio-unlock run the same way
        // they would on a manual switch.
        setMode("usb");

        // Handle Enter on the manual input field
        usbScannerInput.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                const value = usbScannerInput.value.trim();
                usbScannerInput.value = "";
                if (value) {
                    scanResult.textContent = value;
                    scanStatus.textContent = "USB scanner input received.";
                    processScan(value);
                }
            }
        });

        // Global keyboard listener: capture rapid-fire input from USB/BT scanners.
        // Buffers keystrokes and only fires processScan when Enter is received.
        let globalScanBuffer = "";

        document.addEventListener("keydown", function (e) {
            if (!usbModeActive) return;

            // Ignore if focus is on a real interactive element (typing a search, etc.)
            const tag = document.activeElement && document.activeElement.tagName;
            const isEditable = document.activeElement && document.activeElement.isContentEditable;
            if ((tag === "INPUT" || tag === "TEXTAREA" || isEditable) && document.activeElement !== usbScannerInput) return;

            if (e.key === "Enter") {
                const value = globalScanBuffer.trim();
                globalScanBuffer = "";
                if (value) {
                    scanResult.textContent = value;
                    scanStatus.textContent = "USB scanner input received.";
                    processScan(value);
                }
                return;
            }

            // Only accumulate printable single characters
            if (e.key.length === 1) {
                globalScanBuffer += e.key;
            }
        });

        // ── End USB / Bluetooth scanner mode ─────────────────────────────────

        // ── Shelf unit panel ──────────────────────────────────────────────────
        const shelfUnitPanel = document.getElementById("shelfUnitPanel");
        const shelfUnitIdentifier = document.getElementById("shelfUnitIdentifier");
        const shelfUnitStatus = document.getElementById("shelfUnitStatus");
        const shelfSlotsContainer = document.getElementById("shelfSlotsContainer");
        const saveShelfUnitBtn = document.getElementById("saveShelfUnitBtn");
        const shelfUnitSaveStatus = document.getElementById("shelfUnitSaveStatus");

        let currentShelfUnitId = null;
        let currentShelfSlot = null;
        let currentItemId = null;

        const STATUS_LABELS = ["Active Inventory", "Unlisted", "Needs Sorted"];

        // ── Shelf slot panel ──────────────────────────────────────────────────
        const shelfSlotPanel = document.getElementById("shelfSlotPanel");
        const shelfSlotLabel = document.getElementById("shelfSlotLabel");
        const shelfSlotStatus = document.getElementById("shelfSlotStatus");
        const saveShelfSlotBtn = document.getElementById("saveShelfSlotBtn");
        const viewShelfSlotItemsBtn = document.getElementById("viewShelfSlotItemsBtn");
        const shelfSlotSaveStatus = document.getElementById("shelfSlotSaveStatus");
        const shelfSlotItemsContainer = document.getElementById("shelfSlotItemsContainer");
        const shelfSlotItemsList = document.getElementById("shelfSlotItemsList");

        function showShelfSlotPanel(resolved) {
            currentShelfSlot = {
                shelfUnitId: resolved.shelfUnitId,
                shelfUnitIdentifier: resolved.shelfUnitIdentifier,
                shelfNumber: resolved.shelfNumber
            };
            shelfSlotLabel.textContent = `${resolved.shelfUnitIdentifier}-${resolved.shelfNumber}`;
            shelfSlotStatus.value = String(resolved.slotStatus);
            shelfSlotSaveStatus.textContent = "";
            shelfSlotItemsContainer.classList.add("d-none");
            shelfSlotItemsList.innerHTML = "";
            shelfSlotPanel.classList.remove("d-none");
        }

        saveShelfSlotBtn.addEventListener("click", async function () {
            if (!currentShelfSlot) return;
            shelfSlotSaveStatus.textContent = "Saving...";
            try {
                const response = await fetch(appUrl("/Home/UpdateShelfSlotStatus"), {
                    method: "POST",
                    headers: { "Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest" },
                    body: JSON.stringify({
                        shelfUnitId: currentShelfSlot.shelfUnitId,
                        shelfNumber: currentShelfSlot.shelfNumber,
                        status: parseInt(shelfSlotStatus.value, 10)
                    })
                });
                const result = await response.json();
                shelfSlotSaveStatus.textContent = result.message || (result.success ? "Saved." : "Failed.");
            } catch (error) {
                shelfSlotSaveStatus.textContent = "Save failed.";
                console.error(error);
            }
        });

        viewShelfSlotItemsBtn.addEventListener("click", async function () {
            if (!currentShelfSlot) return;
            try {
                const response = await fetch(appUrl(`/Home/GetShelfSlotItems?shelfUnitIdentifier=${encodeURIComponent(currentShelfSlot.shelfUnitIdentifier)}&shelfNumber=${currentShelfSlot.shelfNumber}`));
                const data = await response.json();
                shelfSlotItemsList.innerHTML = "";
                if (data.items && data.items.length > 0) {
                    for (const item of data.items) {
                        const li = document.createElement("li");
                        li.className = "list-group-item px-0 py-1";
                        const link = document.createElement("a");
                        link.href = appUrl(`/Inventory/Details/${encodeURIComponent(item.itemId)}`);
                        link.textContent = item.itemTitle || item.itemId;
                        link.target = "_blank";
                        li.appendChild(link);
                        shelfSlotItemsList.appendChild(li);
                    }
                } else {
                    const li = document.createElement("li");
                    li.className = "list-group-item px-0 py-1 text-muted small";
                    li.textContent = "No items on this shelf.";
                    shelfSlotItemsList.appendChild(li);
                }
                shelfSlotItemsContainer.classList.remove("d-none");
            } catch (error) {
                console.error("Failed to load shelf items.", error);
            }
        });
        // ── End shelf slot panel ──────────────────────────────────────────────

        // ── Item panel ────────────────────────────────────────────────────────
        const itemPanel = document.getElementById("itemPanel");
        const itemPanelTitle = document.getElementById("itemPanelTitle");
        const itemPanelLocation = document.getElementById("itemPanelLocation");
        const itemPanelPhoto = document.getElementById("itemPanelPhoto");
        const itemPanelViewBtn = document.getElementById("itemPanelViewBtn");
        const itemPanelRemoveBtn = document.getElementById("itemPanelRemoveBtn");
        const itemPanelStatus = document.getElementById("itemPanelStatus");

        function showItemPanel(resolved) {
            currentItemId = resolved.itemId;
            itemPanelTitle.textContent = resolved.title || resolved.itemId;
            itemPanelLocation.textContent = resolved.locationText || "None";
            itemPanelViewBtn.href = appUrl(`/Inventory/Details/${encodeURIComponent(resolved.itemId)}`);
            itemPanelStatus.textContent = "";
            if (resolved.coverPhotoUrl) {
                itemPanelPhoto.src = resolved.coverPhotoUrl;
                itemPanelPhoto.style.display = "";
            } else {
                itemPanelPhoto.style.display = "none";
            }
            itemPanel.classList.remove("d-none");
        }

        itemPanelRemoveBtn.addEventListener("click", async function () {
            if (!currentItemId) return;
            itemPanelStatus.textContent = "Removing...";
            try {
                const response = await fetch(appUrl("/Home/RemoveItemLocation"), {
                    method: "POST",
                    headers: { "Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest" },
                    body: JSON.stringify({ itemId: currentItemId })
                });
                const result = await response.json();
                itemPanelStatus.textContent = result.message || (result.success ? "Removed." : "Failed.");
                if (result.success) {
                    itemPanelLocation.textContent = "None";
                }
            } catch (error) {
                itemPanelStatus.textContent = "Failed.";
                console.error(error);
            }
        });
        // ── End item panel ────────────────────────────────────────────────────

        async function loadShelfUnitPanel(barcode) {
            try {
                const response = await fetch(appUrl(`/Home/GetShelfUnit?barcode=${encodeURIComponent(barcode)}`));
                if (!response.ok) return;
                const data = await response.json();
                if (!data.found) return;

                currentShelfUnitId = data.id;
                shelfUnitIdentifier.textContent = data.identifier;
                shelfUnitStatus.value = String(data.status);

                shelfSlotsContainer.innerHTML = "";
                const table = document.createElement("table");
                table.className = "table table-sm mb-0";
                table.innerHTML = "<thead><tr><th>Shelf</th><th>Status</th></tr></thead>";
                const tbody = document.createElement("tbody");
                for (const slot of data.slots) {
                    const tr = document.createElement("tr");
                    const tdNum = document.createElement("td");
                    tdNum.textContent = `${data.identifier}-${slot.shelfNumber}`;
                    const tdStatus = document.createElement("td");
                    const sel = document.createElement("select");
                    sel.className = "form-select form-select-sm";
                    sel.dataset.shelfNumber = slot.shelfNumber;
                    STATUS_LABELS.forEach((label, i) => {
                        const opt = document.createElement("option");
                        opt.value = String(i);
                        opt.textContent = label;
                        sel.appendChild(opt);
                    });
                    sel.value = String(slot.status);
                    tdStatus.appendChild(sel);
                    tr.appendChild(tdNum);
                    tr.appendChild(tdStatus);
                    tbody.appendChild(tr);
                }
                table.appendChild(tbody);
                shelfSlotsContainer.appendChild(table);

                shelfUnitSaveStatus.textContent = "";
                shelfUnitPanel.classList.remove("d-none");
            } catch (error) {
                console.error("Failed to load shelf unit.", error);
            }
        }

        saveShelfUnitBtn.addEventListener("click", async function () {
            if (!currentShelfUnitId) return;

            const slots = [];
            shelfSlotsContainer.querySelectorAll("select[data-shelf-number]").forEach(sel => {
                slots.push({ shelfNumber: parseInt(sel.dataset.shelfNumber, 10), status: parseInt(sel.value, 10) });
            });

            try {
                shelfUnitSaveStatus.textContent = "Saving...";
                const response = await fetch(appUrl("/Home/UpdateShelfUnit"), {
                    method: "POST",
                    headers: { "Content-Type": "application/json", "X-Requested-With": "XMLHttpRequest" },
                    body: JSON.stringify({
                        id: currentShelfUnitId,
                        status: parseInt(shelfUnitStatus.value, 10),
                        slots
                    })
                });
                const result = await response.json();
                shelfUnitSaveStatus.textContent = result.message || (result.success ? "Saved." : "Failed.");
            } catch (error) {
                shelfUnitSaveStatus.textContent = "Save failed.";
                console.error(error);
            }
        });
        // ── End shelf unit panel ──────────────────────────────────────────────

        // Fallback: unlock audio on first touch (covers iOS edge cases before camera starts)
        document.addEventListener("touchstart", function onFirstTouch() {
            unlockAudio();
            document.removeEventListener("touchstart", onFirstTouch);
        }, { passive: true });
    </script>
}
